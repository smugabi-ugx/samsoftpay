# --- This app's public URL (https, reachable by Shopify) ---
APP_URL=https://your-app.example.com
PORT=8080

# --- Shopify app credentials (from the Partner Dashboard) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2024-10
SHOPIFY_SCOPES=read_payment_gateways,read_payment_sessions

# --- Samsoftpay ---
SAMSOFTPAY_BASE_URL=https://api.samsoftpay.com
SAMSOFTPAY_SECRET_KEY=sk_test_xxx        # sk_live_ in production
SAMSOFTPAY_WEBHOOK_SECRET=whsec_xxx      # Account -> Webhooks in the Samsoftpay dashboard

# --- Optional: where the file-backed store lives (swap for a real DB in prod) ---
# STORE_FILE=/var/data/store.json
